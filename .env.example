# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RAZORPAY CONFIGURATION:
# Provide your Razorpay Key ID and Secret to accept live online payments.
# If left blank, the app runs in interactive test checkout simulation mode.
VITE_RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="placeholder_secret_key"

# ADMIN PANEL CREDENTIALS:
# Default placeholders for administrative access. Set your own secure credentials in deployment.
ADMIN_EMAIL="beingmagrajpvt@gmail.com"
VITE_ADMIN_EMAIL="beingmagrajpvt@gmail.com"
ADMIN_PASSWORD="placeholder_admin_password"
ADMIN_PASSWORD_HASH="sha256_hash_placeholder"
VITE_ADMIN_DEFAULT_EMAIL="beingmagrajpvt@gmail.com"
